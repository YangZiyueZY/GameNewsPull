{
  "name": "er-you-news",
  "private": true,
  "type": "module",
  "scripts": {
    "crawl": "tsx apps/crawler/src/index.ts",
    "crawl:once": "tsx apps/crawler/src/index.ts --once",
    "feed:rebuild": "tsx apps/crawler/src/rebuild.ts",
    "fixtures": "tsx scripts/snapshot-fixtures.ts",
    "test": "tsx --test tests/*.test.ts",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "sync:public": "node scripts/sync-public.mjs",
    "//build": "clean-clone 安全：先同步 docs/img 与 docs/api 到 public/，再 vite build",
    "build": "npm run sync:public && npm run web:build"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
